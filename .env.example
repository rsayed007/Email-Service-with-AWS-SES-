# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_LOG_LEVEL=info           # debug | info | warn | error

# ── REST API ──────────────────────────────────────────────────────────────────
API_PORT=8080
API_READ_TIMEOUT=30s
API_WRITE_TIMEOUT=30s
API_IDLE_TIMEOUT=60s

# ── SMTP Proxy ────────────────────────────────────────────────────────────────
SMTP_PORT=2525
SMTP_DOMAIN=mail.example.com
SMTP_MAX_MESSAGE_BYTES=10485760   # 10 MB
SMTP_MAX_RECIPIENTS=50

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=email_service
MYSQL_USER=email_user
MYSQL_PASSWORD=email_password
MYSQL_ROOT_PASSWORD=rootpassword
# Full DSN (overrides individual fields when set)
# DATABASE_URL=email_user:email_password@tcp(localhost:3306)/email_service?parseTime=true&charset=utf8mb4
MYSQL_MAX_OPEN_CONNS=25
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME=5m

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_DB=0
REDIS_POOL_SIZE=10

# ── AWS SES ───────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# Optional: assume a role for sending
# AWS_SES_ROLE_ARN=arn:aws:iam::123456789012:role/SESRole
# Configuration set name for event publishing
SES_CONFIGURATION_SET=email-service-events

# ── AWS SNS (bounce/complaint webhooks) ───────────────────────────────────────
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:email-events
# Shared secret for SNS message signature verification
SNS_WEBHOOK_SECRET=change_me_to_a_random_secret

# ── Tracking ──────────────────────────────────────────────────────────────────
TRACKING_BASE_URL=https://track.example.com
TRACKING_PIXEL_PATH=/t/open
TRACKING_CLICK_PATH=/t/click

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Global fallback limits (per-client overrides stored in DB)
RATE_LIMIT_DEFAULT_HOURLY=500
RATE_LIMIT_DEFAULT_MONTHLY=10000

# ── Queue / Worker ────────────────────────────────────────────────────────────
QUEUE_CONCURRENCY=10           # parallel SES send goroutines per worker
QUEUE_RETRY_MAX=3
QUEUE_RETRY_DELAY=5s

# ── Security ──────────────────────────────────────────────────────────────────
# 32-byte hex key used to sign tracking tokens (openssl rand -hex 32)
TRACKING_HMAC_SECRET=replace_with_32_byte_hex_secret
# bcrypt cost for SMTP password hashing
BCRYPT_COST=12
